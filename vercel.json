{
  "rewrites": [
    {
      "source": "/buscador",
      "destination": "https://buscador-vacantes.vercel.app/buscador/index.html"
    },
    {
      "source": "/buscador/",
      "destination": "https://buscador-vacantes.vercel.app/buscador/index.html"
    },
    {
      "source": "/buscador/:path+",
      "destination": "https://buscador-vacantes.vercel.app/buscador/:path+"
    },
    {
      "source": "/vacantes",
      "destination": "https://buscador-vacantes.vercel.app/vacantes"
    },
    {
      "source": "/vacante/:c",
      "destination": "https://buscador-vacantes.vercel.app/vacante/:c"
    },
    {
      "source": "/api/:path*",
      "destination": "https://buscador-vacantes.vercel.app/api/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://buscador-vacantes.vercel.app/sitemap.xml"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
